# ReadFocus backend environment. Copy to .env and fill in real values.
# Never commit .env. Use a development Supabase project, not production.

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server-side only, never expose to the frontend.
SUPABASE_SERVICE_KEY=

# Browser origins allowed by CORS (backend/cors.py): one origin, or several
# separated by commas, no trailing slash. Production: the Vercel URL.
FRONTEND_URL=http://localhost:5173

# development | production. Only ENV=development also allows the local Vite
# origins (localhost and 127.0.0.1, ports 5173-5176).
ENV=development

# Local model cache for fastembed (git-ignored)
FASTEMBED_CACHE=.cache/fastembed
# ONNX Runtime threads for the embedding model. Optional; default 1, which
# is fastest on a 0.1-CPU host. Raise it on a multi-core machine.
# EMBED_THREADS=1
