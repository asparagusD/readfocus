# ReadFocus backend environment. Copy to .env and fill in real values.
# Never commit .env. Use a development Supabase project, not production.

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server-side only, never expose to the frontend.
SUPABASE_SERVICE_KEY=

# CORS origin of the frontend
FRONTEND_URL=http://localhost:5173

# development | production
ENV=development

# Local model cache for fastembed (git-ignored)
FASTEMBED_CACHE=.cache/fastembed

# --- AI provider keys: to be removed in C8 ---
# Still read by backend/services/llm.py
GROQ_API_KEY=
# Still read by backend/services/embeddings.py
GOOGLE_AI_STUDIO_KEY=
