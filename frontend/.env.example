# ReadFocus frontend environment. Copy to .env and fill in real values.
# Only VITE_-prefixed variables reach the browser; never put a service key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Public address of the deployed frontend, no trailing slash (C13.10e). Sets the
# canonical link and absolute share-image URLs; left out when empty.
VITE_SITE_URL=
