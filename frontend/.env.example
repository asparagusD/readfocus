# ReadFocus frontend environment. Copy to .env and fill in real values.
# Only VITE_-prefixed variables reach the browser; never put a service key here.
# Vite bakes them into the bundle at build time: changing one needs a rebuild.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Public address of the deployed frontend, no trailing slash (C13.10e). Sets the
# canonical link and absolute share-image URLs; left out when empty.
VITE_SITE_URL=

# Production (Vercel Hobby, C14.2): set these in Vercel, Settings > Environment
# Variables, for Production and Preview; never in a committed file.
#   VITE_API_URL            required  Render backend, e.g. https://readfocus-backend.onrender.com
#                                     (https, not localhost, no trailing slash)
#   VITE_SUPABASE_URL       required  https://<project-ref>.supabase.co of the production project
#   VITE_SUPABASE_ANON_KEY  required  the publishable (anon) key; a secret or service-role key
#                                     fails the build
#   VITE_SITE_URL           optional  the Vercel URL, e.g. https://readfocus.vercel.app; a build
#                                     without it warns
# A Vercel build (VERCEL=1, set by Vercel) stops with the list of problems if a required
# variable is missing or wrong (src/deploy/deployEnv.js); local, CI and e2e builds are not checked.
# Vercel project: Root Directory `frontend`; build and output come from vercel.json
# (`npm run build`, `dist`). Every path except /assets/ is rewritten to index.html.
