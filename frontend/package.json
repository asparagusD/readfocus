{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs && node scripts/copy-excalidraw.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr.mjs && node scripts/copy-excalidraw.mjs",
    "build": "vite build && vite build --ssr src/prerender.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:images": "node scripts/check-images.mjs",
    "preview": "vite preview",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.js",
    "test:isolation": "node scripts/live/check-isolation.mjs",
    "make:og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "dompurify": "3.4.17",
    "katex": "0.19.1",
    "lucide-react": "^1.14.0",
    "mathml-to-latex": "1.8.0",
    "motion": "^14.12.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "0.35.5",
    "vite": "^8.0.10"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16",
        "mermaid": {
          "katex": "0.19.1"
        }
      }
    },
    "lodash-es": "4.18.1"
  }
}
